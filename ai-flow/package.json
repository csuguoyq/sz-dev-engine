{
  "name": "ai-flow",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "bin": {
    "ai-flow": "./dist/cli.js"
  },
  "scripts": {
    "build": "tsc && tsc -p viewer-ui --noEmit && vite build",
    "build:viewer": "vite build",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "test": "tsc -p tsconfig.test.json && node --import tsx --test --test-timeout=120000 test/*.test.ts",
    "ai-flow": "tsx src/cli.ts",
    "clean": "rimraf dist",
    "clean:cache": "rimraf dist .vite node_modules/.vite *.tsbuildinfo"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@mui/material": "^9.4.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "smol-toml": "^1.9.0",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "rimraf": "^6.1.3",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3",
    "vite": "^8.3.0"
  }
}
