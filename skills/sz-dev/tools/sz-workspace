# sync-skill: push THIS repository's skill copy (the tool's own
# skills/sz-dev) to the installed copy and to every registered
# workspace's / replay tree's seeded skills/sz-dev. The repo copy is the
# single source of truth for skill edits; this turns the three-way sync
# into one verified command. Tracked skill files inside workspaces are
# marked skip-worktree (the sz-replay init mechanism) so the seeded copy
# never surfaces as a working-tree change; every target is verified with
# diff -rq before success is reported.
cmd_sync_skill() {
    local src inst reg f name path dst top n=0
    src="$(dirname "$(dirname "$(readlink -f "$0")")")"
    inst="$(readlink -f "${SZ_SKILL_INSTALL_DIR:-$HOME/.zcode/skills/sz-dev}")"
    [[ -f "$src/SKILL.md" ]] || { log "ERROR: $src is not a sz-dev skill dir"; exit 1; }
    case "$src" in "$inst"|"$inst"/*)
        log "ERROR: source is the installed copy ($src) — run this from the repository's skills/sz-dev (the repo copy is the source of truth)"
        exit 1 ;;
    esac
    reg="$(registry_dir)"
    local dsts=()
    dsts+=("$inst")
    for f in "$reg"/SZ*; do
        [[ -f "$f" ]] || continue
        name="$(basename "$f")"
        case "$name" in *.mode|*.meta) continue ;; esac
        path="$(cat "$f")"
        if [[ -d "$path/.git" ]]; then
            dsts+=("$(readlink -f "$path")/skills/sz-dev")
        else
            log "skip (not a checkout): $path"
        fi
    done
    local dst top
    for dst in ${dsts[@]+"${dsts[@]}"}; do
        [[ "$dst" == "$src" || "$dst" == "$src"/* ]] && continue
        mkdir -p "$dst"
        # tracked skill files must not surface as working-tree changes:
        # skip-worktree them (git then ignores the seeded copy)
        top="$(git -C "$dst" rev-parse --show-toplevel 2>/dev/null || true)"
        if [[ -n "$top" ]]; then
            git -C "$top" ls-files -z -- skills/sz-dev 2>/dev/null \
                | xargs -0 -r git -C "$top" update-index --skip-worktree -- 2>/dev/null || true
        fi
        rsync -a --delete --exclude __pycache__ "$src/" "$dst/" || { log "ERROR: rsync into $dst failed"; exit 1; }
        if diff -rq --exclude __pycache__ "$src" "$dst" >/dev/null 2>&1; then
            log "synced: $dst"
            n=$((n + 1))
        else
            log "ERROR: $dst still differs after rsync"
            exit 1
        fi
    done
    echo "SYNCED=$n"
}

case "${1:-}" in
    ensure)
        shift
        cmd_ensure "$@"
        ;;
    check)
        shift
        cmd_check "$@"
        ;;
    snapshot)
        shift
        cmd_snapshot "$@"
        ;;
    package)
        shift
        cmd_package "$@"
        ;;
    config)
        [[ $# -le 1 ]] || usage
        cmd_config
        ;;
    list)
        [[ $# -le 2 ]] || usage
        cmd_list "${2:-}"
        ;;
    remove)
        shift
        cmd_remove "$@"
        ;;
    sync-skill)
        [[ $# -le 1 ]] || usage
        cmd_sync_skill
        ;;
    mr)
        shift
        cmd_mr "$@"
        ;;
    *)
        usage
        ;;
esac
